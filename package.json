{
  "name": "dsh-image-viewer-pro",
  "version": "0.1.3",
  "description": "A proper image viewer for DeepSeek Harness: zoom, pan, rotate, download, copy, open with the default app, and gallery browsing for images inside the chat.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "NingYuanLee <liyunningyuan@outlook.com>",
  "homepage": "https://github.com/NingYuanLee/dsh-image-viewer-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingYuanLee/dsh-image-viewer-pro.git"
  },
  "bugs": {
    "url": "https://github.com/NingYuanLee/dsh-image-viewer-pro/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis-plugin",
    "image-viewer",
    "image-gallery",
    "lightbox",
    "zoom",
    "pan",
    "screenshot"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "screenshots.json",
    "locale/*.json",
    "docs/*.png"
  ],
  "scripts": {
    "test": "node test/smoke.test.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
